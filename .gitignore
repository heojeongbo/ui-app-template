node_modules/
dist/
build/
coverage/

# Build info from `tsc -b` project references.
*.tsbuildinfo

# Intlayer's compiled dictionaries and the .d.ts augmentation that makes a
# dictionary key checkable. Produced by the Vite plugin during dev/build and by
# `intlayer build`, never committed — apps/web's `pretype:check` runs that build
# so a cold checkout type-checks. See docs/i18n.md.
.intlayer/

# TanStack Router's plugin cache. `routeTree.gen.ts` itself IS committed.
.tanstack/

# Playwright
e2e/test-results/
e2e/playwright-report/
e2e/blob-report/
e2e/.auth/

# Local env overrides. `.env` and `.env.example` are committed.
.env.local
.env.*.local

# Dev TLS certs generated by scripts/ensure-dev-cert.sh
certs/

.DS_Store
*.log
