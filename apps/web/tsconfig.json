{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"types": ["vite/client"],
		// Mirrored in vite.config.ts `resolve.alias`. Both must agree, or you get
		// the failure mode that costs the most time: it resolves in Vite and not
		// in tsc, so the dev server is happy and CI is not.
		"paths": {
			"@/*": ["./src/*"],
			"@template/core/*": ["../../packages/core/src/*"],
			"@template/design/*": ["../../packages/design/src/*"],
			"@template/interfaces/*": ["../../packages/interfaces/src/*"],
			"@template/interfaces": ["../../packages/interfaces/src/index.ts"]
		}
	},
	// `.intlayer/types` carries the module augmentation that makes
	// `useIntlayer("items")` a checked key rather than an unknown one. It is
	// generated and gitignored, which is why `pretype:check` builds it first:
	// without that, a fresh clone type-checks red on keys that are perfectly
	// valid, and only on a machine that has never run the dev server.
	"include": [
		"src",
		"vite.config.ts",
		"intlayer.config.ts",
		".intlayer/types/**/*.ts",
		".intlayer/types/**/*.d.ts"
	]
}
