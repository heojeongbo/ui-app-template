# Copy to `.env.local` for local overrides. Values here are BUILD-TIME: Vite
# inlines them, so a built image cannot be re-pointed with them. For anything
# that differs per deployment of the same image, use public/config.js instead.

# Where RPCs go. Same-origin by default so the session cookie flows.
VITE_API_BASE_URL=/api

# connect (JSON, readable in DevTools) | grpc-web (for gateways that need it)
VITE_API_PROTOCOL=connect

# debug | log | info | warn | error. Defaults to debug in dev, warn in prod.
# VITE_LOG_LEVEL=debug

# Answer RPCs locally instead of hitting a server.
# VITE_ENABLE_MOCKS=true

# Where the dev server proxies /api. Unset = no proxy.
# VITE_API_PROXY_TARGET=http://localhost:8080
