{
	// Standalone: the e2e suite runs in Node against a built app, not in the
	// browser bundle, and it must not inherit the app's path aliases.
	//
	// DOM is in `lib` all the same, because a `page.evaluate` callback really
	// does execute in a browser — it is serialised and run there. Without it,
	// `document` inside one is a type error.
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"types": ["node"],
		"lib": ["ES2023", "DOM"]
	},
	"include": ["tests", "playwright.config.ts", "fixtures"]
}
