{
	"compilerOptions": {
		"target": "ES2022",
		// ES2023 for `Array.prototype.with` / `toSorted` / `findLast` — immutable
		// array updates read far better than a spread-and-splice, and every
		// runtime this template targets (Node 22+, current browsers) has them.
		// `target` stays ES2022: lib says what exists, target says what to emit.
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",

		// `strict` is the floor, not the ceiling — it is a 2016-era bundle that
		// stopped growing, and every flag below is one TypeScript deliberately
		// left out of it because it breaks existing code. A template has no
		// existing code, so this is the one moment they are free.
		"strict": true,

		// `arr[i]` is `T | undefined`, not `T`. The single highest-value flag
		// here: without it every index read is an unchecked assertion, and the
		// bug it hides — a lookup that misses — is the most common runtime
		// `undefined` in a UI app.
		"noUncheckedIndexedAccess": true,
		// `obj.foo` must be `obj["foo"]` when `foo` only exists via an index
		// signature. The declared-vs-guessed distinction is the point: it is
		// what catches a typo'd `import.meta.env.VITE_API_BSAE_URL`, which is
		// otherwise `undefined` at runtime and silent at compile time.
		"noPropertyAccessFromIndexSignature": true,
		// A method that means to override must say so — otherwise renaming a
		// base method silently turns every override into a new sibling method
		// that nothing calls.
		"noImplicitOverride": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedSideEffectImports": true,
		"allowUnreachableCode": false,
		"allowUnusedLabels": false,
		// `erasableSyntaxOnly` is NOT set here, and the reason is a limitation
		// of tsconfig rather than a disagreement with the flag. Banning
		// `enum` / `namespace` / parameter properties is right — they need a
		// type-directed emit, and every bundler in this template (Vite,
		// esbuild, tsx) erases types file-by-file and cannot produce one.
		//
		// But protoc-gen-es emits real `enum`s, and compiler options cannot be
		// scoped to a glob. Relaxing the flag in `packages/interfaces` does
		// not contain it: `apps/web` resolves `@template/interfaces` through
		// tsconfig `paths` to raw `.ts`, so the generated file is re-checked
		// under the CONSUMER's options and fails there instead.
		//
		// Biome can scope to a glob, and already excludes generated trees, so
		// the same three constraints are enforced as `style/noEnum`,
		// `style/noNamespace` and `style/noParameterProperties` in
		// biome.jsonc — where the quarantine actually holds.

		// `exactOptionalPropertyTypes` is deliberately OFF, and it is the only
		// strictness flag this template declines.
		//
		// It is correct in principle — `{ q?: string }` accepting `{ q:
		// undefined }` really does erase the difference between "absent" and
		// "present and undefined", which at the router boundary is the
		// difference between `/items` and `/items?q=`.
		//
		// It was measured, not assumed: turning it on produced 32 errors, and
		// almost none were our bugs. React's ecosystem does not model the
		// distinction — Radix, TanStack Query and TanStack Router all declare
		// `prop?: T` rather than `prop?: T | undefined`, so merely FORWARDING
		// an optional prop fails. The disqualifying case was
		// `ui/primitive/dropdown-menu.tsx`: shadcn CLI output, regenerated by
		// `pnpm ui:add`, which cannot be hand-fixed and would leave the
		// template's whole component-install path permanently red.
		//
		// The distinction is preserved where it actually matters by writing
		// `q?: string | undefined` explicitly — see `ItemsSearch` in
		// apps/web/src/pages/items/items.filters.ts.
		"exactOptionalPropertyTypes": false,
		// Off deliberately: Biome owns unused-symbol reporting, and having both
		// complain means every in-progress edit fails type-check for a reason the
		// linter already surfaces with an autofix.
		"noUnusedLocals": false,
		"noUnusedParameters": false,

		"skipLibCheck": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		// Every import is either erased or emitted exactly as written. Without it,
		// a type-only import of a module with side effects can be silently dropped.
		"verbatimModuleSyntax": true,
		"moduleDetection": "force",
		"isolatedModules": true
	}
}
