{
	"compilerOptions": {
		"target": "ES2022",
		// ES2023 for `Array.prototype.with` / `toSorted` / `findLast` — immutable
		// array updates read far better than a spread-and-splice, and every
		// runtime this template targets (Node 22+, current browsers) has them.
		// `target` stays ES2022: lib says what exists, target says what to emit.
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",

		"strict": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedSideEffectImports": true,
		// Off deliberately: Biome owns unused-symbol reporting, and having both
		// complain means every in-progress edit fails type-check for a reason the
		// linter already surfaces with an autofix.
		"noUnusedLocals": false,
		"noUnusedParameters": false,

		"skipLibCheck": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		// Every import is either erased or emitted exactly as written. Without it,
		// a type-only import of a module with side effects can be silently dropped.
		"verbatimModuleSyntax": true,
		"moduleDetection": "force",
		"isolatedModules": true
	}
}
